# AI Pair Programmer Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# Core Application Settings
# =============================================================================
NODE_ENV=development
PORT=8080
APP_NAME="AI Pair Programmer"
APP_VERSION=1.0.0

# =============================================================================
# AI Engine Configuration
# =============================================================================
# LLM Provider Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Alternative providers (uncomment to use)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_AI_API_KEY=your_google_ai_key_here

# AI Engine Settings
AI_SUGGESTION_TIMEOUT_MS=3000
AI_MAX_CANDIDATES=5
AI_CONTEXT_WINDOW_SIZE=4000

# =============================================================================
# Code Analysis Settings
# =============================================================================
PARSER_CACHE_SIZE_MB=256
AST_DELTA_TTL_SECONDS=300
SYMBOL_GRAPH_MAX_NODES=10000

# =============================================================================
# Telemetry & Observability
# =============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://localhost:4318/v1/traces
TELEMETRY_SAMPLING_RATE=1.0
METRICS_EXPORT_INTERVAL_MS=5000

# =============================================================================
# Security & Compliance
# =============================================================================
# PII Redaction
PII_REDACTION_ENABLED=true
PII_PATTERNS_FILE=config/pii-patterns.json

# Session & Auth
JWT_SECRET=your_jwt_secret_here_min_32_chars
SESSION_TIMEOUT_HOURS=24
REFRESH_TOKEN_DAYS=7

# =============================================================================
# Database & Storage
# =============================================================================
# For future use - Phase 2
# DATABASE_URL=postgresql://user:pass@localhost:5432/ai_pair_programmer
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_REALTIME_COLLABORATION=false
FEATURE_MULTI_LANGUAGE_SUPPORT=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_ENTERPRISE_SSO=false

# =============================================================================
# Performance & Optimization
# =============================================================================
BUNDLE_SIZE_LIMIT_KB=300
SUGGESTION_LATENCY_BUDGET_MS=2000
CACHE_TTL_SECONDS=60

# =============================================================================
# Development & Testing
# =============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
MOCK_AI_RESPONSES=false
TEST_DATA_SEED=12345

# =============================================================================
# Deployment & Infrastructure
# =============================================================================
# For production deployment
# DEPLOY_ENV=production
# CDN_BASE_URL=https://cdn.aipairprogrammer.dev
# MONITORING_WEBHOOK_URL=https://hooks.slack.com/your/webhook/url
